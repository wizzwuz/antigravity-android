# AGY v2 — APK signing configuration.
# Production release key lives outside the repository in ~/.keys/signing.env
# (never committed). External contributors without ~/.keys/signing.env fall
# back to a local ~/.android/debug.keystore generated on demand in 09-sign.sh.

_SIGN_ENV="${SIGNING_ENV:-}"
if [ -z "$_SIGN_ENV" ] && [ -n "${HOME:-}" ] && [ -f "$HOME/.keys/signing.env" ]; then
    _SIGN_ENV="$HOME/.keys/signing.env"
elif [ -z "$_SIGN_ENV" ] && [ -n "${USERPROFILE:-}" ]; then
    _UP_UNIX="$(printf '%s' "$USERPROFILE" | tr '\\' '/')"
    if [ -f "$_UP_UNIX/.keys/signing.env" ]; then
        _SIGN_ENV="$_UP_UNIX/.keys/signing.env"
    fi
fi

if [ -n "$_SIGN_ENV" ] && [ -f "$_SIGN_ENV" ]; then
    # shellcheck disable=SC1090
    . "$_SIGN_ENV"
else
    if [ -z "${KEYSTORE:-}" ]; then
        if [ -f "${PROJECT:-.}/tools/debug.keystore" ]; then
            KEYSTORE="${PROJECT:-.}/tools/debug.keystore"
        elif [ -f "${HOME:-.}/.android/debug.keystore" ]; then
            KEYSTORE="${HOME:-.}/.android/debug.keystore"
        else
            KEYSTORE="${PROJECT:-.}/tools/debug.keystore"
        fi
    fi
    KEY_ALIAS="${KEY_ALIAS:-androiddebugkey}"
    KEY_PASS="${KEY_PASS:-android}"
    STORE_PASS="${STORE_PASS:-android}"
fi
unset _SIGN_ENV _UP_UNIX
